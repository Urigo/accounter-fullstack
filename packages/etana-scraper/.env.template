; Etana scraper environment reference. Copy to `packages/etana-scraper/.env`.
;
; Read by `yarn start` / `yarn dev`, which load `.env` from the current directory (this package
; when run through `yarn workspace`). A missing required value stops the run with
; "Environment variable … is not defined". [secret] marks values that must never be committed.

; Postgres connection string for the Accounter database the scraper writes to,
; e.g. postgres://user:password@localhost:5432/accounter. Required. [secret]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/accounter

; Path (relative to the working directory, or absolute) of the account CSV exported from the Etana
; dashboard (Accounts → pick the account → Export). Required.
CSV_EXPORT_FILEPATH=./etana-export.csv

; `diary` log filter: `*` logs everything (the default), a scope name (e.g. `main`) logs only it.
# DEBUG_LOG=*
