; Email-ingestion gateway (Node service, `src/index.ts`) environment reference. Copy to
; `packages/email-ingestion-gateway/.env` for local development.
;
; Every variable the gateway service reads is listed here. They are validated at startup by
; `src/environment.ts`, and an invalid value stops the process. This package reads only its own
; `.env` (never the root one); the deployed container has no `.env` and takes its environment from
; the platform. The Cloudflare Worker (`src/worker.ts`) is configured separately: see
; `.dev.vars.example`. `src/__tests__/env-template.test.ts` keeps both files in sync with the code.
;
; Conventions: active entries are what a working local setup needs; commented-out `# VAR=value`
; entries are optional, shown with their default. [secret] marks values that must never be
; committed. Placeholders only.

#################
# Feature flags #
#################

; Master kill-switch: `1` enables POST /webhook; `0` answers it with 503. `1` or `0` (default: 0).
EMAIL_INGESTION_V2_ENABLED=1
; `1` runs orchestration in the background and answers the Worker at once (the legacy listener stays
; authoritative). `1` or `0` (default: 0).
# EMAIL_INGESTION_SHADOW_MODE=0

##############
# Cloudflare #
##############

; HMAC-SHA256 key the Worker signs each webhook with; must equal the Worker's CF_WEBHOOK_SECRET.
; Optional in the schema, but with NODE_ENV=production the gateway refuses to start without it, and
; without it any caller can forge a valid signature. [secret]
CF_WEBHOOK_SECRET=replace-with-local-secret
; Comma-separated source IPs or IPv4 CIDRs allowed to call /webhook. Empty (the default) disables the
; IP check; the signature check always applies.
# CF_IP_ALLOWLIST=

######################
# Accounter server   #
######################

; Base URL of the Accounter server; `/graphql` is appended (default: http://localhost:4000).
GATEWAY_SERVER_URL=http://localhost:4000
; Sent as `X-Gateway-CP-Token` to authenticate as the gateway control plane. Must equal the server's
; GATEWAY_CP_TOKEN (packages/server/.env.template); empty means the server rejects every ingestion.
; [secret]
GATEWAY_CP_TOKEN=replace-with-local-cp-token

###########
# Runtime #
###########

; HTTP listen port (default: 3000). The Worker's GATEWAY_URL must point at it.
# PORT=3000

; `production` makes CF_WEBHOOK_SECRET mandatory at startup (the Dockerfile sets it); `test` keeps
; the server from listening. Not validated at startup.
# NODE_ENV=development

; `1` shows dotenv's own load diagnostics; off by default, because the deployed container has no
; `.env` and the "failed to load" line was noise. Not validated at startup.
# DOTENV_DEBUG=1

; Loads this file instead of `.env`; a relative path resolves against the working directory (the
; package under `yarn workspace … dev`, the repo root under a root-level vitest). Read before any
; .env file is loaded, so it only works from the shell or a test harness, never from a .env file.
# TEST_ENV_FILE=.env.test
