# Client: GraphQL endpoint to talk to. Leave unset to use the built-in default
# for the Vite mode (localhost:4000 in dev). Set it for preview deploys, branch
# environments, or to point a local client at a non-local backend.
# GRAPHQL_URL=http://localhost:4000/graphql

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_FRONTEND_CLIENT_ID=your_client_id
AUTH0_AUDIENCE=https://api.accounter.com

# Local development bypass (no Auth0)
# Server: Optional Auth0 user id to attach to seeded demo admin user
DEMO_AUTH0_USER_ID=
# Server: Enable X-Dev-Auth header bypass (set only for local development)
# Client: Skip Auth0Provider and use dev bypass headers
ALLOW_DEV_AUTH=1
# Client: Demo business_users.user_id to impersonate (admin or accountant)
DEV_AUTH_USER_ID=
