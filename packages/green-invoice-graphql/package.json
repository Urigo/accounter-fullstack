{
  "name": "@accounter/green-invoice-graphql",
  "version": "0.8.6",
  "type": "module",
  "description": "[FROZEN - no longer published to npm; built from source by @accounter/server] Graphql proxy for Green Invoice API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Urigo/accounter-fullstack.git",
    "directory": "packages/green-invoice-graphql"
  },
  "homepage": "https://github.com/Urigo/accounter-fullstack/packages/green-invoice-graphql#readme",
  "bugs": {
    "url": "https://github.com/Urigo/accounter-fullstack/issues"
  },
  "author": "Gil Gardosh <gilgardosh@gmail.com>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.0.0 || >= 22"
  },
  "keywords": [
    "green invoice",
    "greeninvoice",
    "accountancy",
    "accountant",
    "accounter",
    "graphql",
    "mesh"
  ],
  "scripts": {
    "build": "yarn generate",
    "dev": "node --import ../../scripts/register-esm.js ./src/index.ts",
    "generate": "rimraf .mesh src/.mesh src/mesh-artifacts && mesh build --dir ./src  && node ../../scripts/mesh-artifacts-rename.mjs"
  },
  "dependencies": {
    "@graphql-mesh/config": "0.109.1",
    "@graphql-mesh/cross-helpers": "0.4.16",
    "@graphql-mesh/http": "0.107.1",
    "@graphql-mesh/json-schema": "0.110.1",
    "@graphql-mesh/runtime": "0.107.1",
    "@graphql-mesh/store": "0.105.1",
    "@graphql-mesh/types": "0.105.1",
    "@graphql-mesh/utils": "0.105.1",
    "graphql": "16.14.2",
    "path": "0.12.7"
  },
  "devDependencies": {
    "@graphql-mesh/cli": "0.101.2",
    "@types/mime-types": "3.0.1",
    "mime-types": "3.0.2",
    "rimraf": "6.1.3"
  }
}
