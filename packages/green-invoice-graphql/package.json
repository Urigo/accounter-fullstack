{
  "name": "@accounter/green-invoice-graphql",
  "version": "0.8.7",
  "type": "module",
  "description": "Graphql proxy for Green Invoice API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Urigo/accounter-fullstack.git",
    "directory": "packages/green-invoice-graphql"
  },
  "homepage": "https://github.com/Urigo/accounter-fullstack/packages/green-invoice-graphql#readme",
  "bugs": {
    "url": "https://github.com/Urigo/accounter-fullstack/issues"
  },
  "author": "Gil Gardosh <gilgardosh@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "^20.0.0 || >= 22"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "keywords": [
    "green invoice",
    "greeninvoice",
    "accountancy",
    "accountant",
    "accounter",
    "graphql",
    "mesh"
  ],
  "scripts": {
    "build": "yarn generate && bob build",
    "dev": "node --import ../../scripts/register-esm.js ./src/index.ts",
    "generate": "rimraf src/__generated__ src/mesh-artifacts && mkdir -p src/__generated__ && mesh-compose -o src/__generated__/supergraph.graphql && node --import ../../scripts/register-esm.js scripts/generate-sdk-inputs.ts && graphql-codegen --config codegen.ts",
    "start": "node ./dist",
    "test": "node --import ../../scripts/register-esm.js ./dist/esm/dev-tests/e2e.js"
  },
  "dependencies": {
    "@graphql-mesh/fusion-runtime": "1.12.1",
    "@graphql-mesh/transport-rest": "0.12.2",
    "graphql": "16.14.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.1",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-codegen/typescript-generic-sdk": "5.0.1",
    "@graphql-codegen/typescript-operations": "5.1.0",
    "@graphql-mesh/compose-cli": "1.8.2",
    "@graphql-tools/utils": "12.0.1",
    "@omnigraph/json-schema": "0.112.4",
    "bob-the-bundler": "7.0.1",
    "rimraf": "6.1.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
