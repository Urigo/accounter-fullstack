; Green Invoice API credentials, used only by the manual end-to-end check `src/dev-tests/e2e.ts`
; (it loads this package's `.env`, then the root `.env`). The server does not read these: it uses
; per-tenant credentials stored in the database.
; [secret] Use a sandbox or test account.
GREEN_INVOICE_ID=id
GREEN_INVOICE_SECRET=secret

; API client log level: trace | debug | info | warn | error (default: info). debug and trace log
; every request's headers (including the bearer token) and response bodies.
# GREEN_INVOICE_LOG_LEVEL=info
