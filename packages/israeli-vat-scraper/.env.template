; israeli-vat-scraper environment reference. Copy to `packages/israeli-vat-scraper/.env`.
;
; Login credentials for the Israeli Tax Authority VAT site, used when `vatScraper()` is called
; without a `credentials` argument (and by the `yarn test` end-to-end run). Loaded from `.env` in the
; current directory, then `../../.env`. All three are required in that case. [secret]

; The business's VAT (osek) number.
VAT_NUM=123456789
; Site user code and password.
USER_CODE=code123
USER_PASS=secretpass
