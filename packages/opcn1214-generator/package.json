{
  "name": "@accounter/opcn1214-generator",
  "version": "0.1.0",
  "type": "module",
  "description": "Fully typed application that generates, parses, and validates OPCN 1214 tax reports.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Urigo/accounter-fullstack.git",
    "directory": "packages/opcn1214-generator"
  },
  "homepage": "https://github.com/Urigo/accounter-fullstack/packages/opcn1214-generator#readme",
  "bugs": {
    "url": "https://github.com/Urigo/accounter-fullstack/issues"
  },
  "author": "Gil Gardosh <gilgardosh@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "^20.0.0 || >= 22"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "keywords": [
    "1214",
    "opcn",
    "shaam",
    "accountancy",
    "israeli-tax",
    "tax-forms",
    "accounter"
  ],
  "scripts": {
    "build": "yarn lint && bob build",
    "generate:layout": "tsx scripts/generate-layout.ts",
    "lint": "eslint './src/**/*.{js,ts,tsx}' --ignore-pattern '**/*.generated.ts' --quiet --fix",
    "render:rules": "tsx scripts/render-rules-table.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "iconv-lite": "0.7.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "bob-the-bundler": "7.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
