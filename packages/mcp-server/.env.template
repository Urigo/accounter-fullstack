; MCP server environment reference. Copy to `packages/mcp-server/.env`.
;
; Every variable the MCP server reads is listed here. They are validated at startup by
; `src/config/env.ts`, and a missing or malformed value stops the process with a report. Unlike the
; server and the client, this package reads only its own `.env`, never the root one, and only at
; startup (restart after a change). `src/config/__tests__/env-template.test.ts` keeps this file in
; sync with the schema.
;
; Conventions: active entries are required; commented-out `# VAR=value` entries are optional, shown
; with their default. [secret] marks values that must never be committed. Placeholders only.
; See README.md#configuration and docs/local-development.md for context.

##########
# Server #
##########

; Public HTTPS origin of this server: scheme and host only, no path (no `/mcp`). Published as the
; OAuth `resource` and used to build the discovery URLs. Locally, http://localhost:3100, or the
; tunnel origin when connecting Claude (docs/local-development.md). Required.
MCP_PUBLIC_BASE_URL=http://localhost:3100

; TCP port the HTTP transport listens on (default: 3100).
# MCP_SERVER_PORT=3100

; Kill-switch: `0` disables /mcp and its OAuth metadata (/health and /metrics keep answering).
; `1` or `0` (default: 1).
# MCP_ENABLED=1

#########
# Tools #
#########

; Comma-separated tool names to expose. Empty (the default) exposes every tool; a non-empty list
; exposes only those. Keep `accounter_list_business_memberships` in a narrowed list: it is how the
; model discovers businesses.
# MCP_TOOL_ALLOWLIST=

; `1` exposes the mutating (write) tools, still subject to MCP_TOOL_ALLOWLIST. Off by default so an
; upgrade never grants write access unasked. `1` or `0` (default: 0).
# MCP_ENABLE_WRITE_TOOLS=0

; Per-user, per-tool rate limit as JSON {"windowMs": <ms>, "max": <calls>}. Empty or invalid falls
; back to 60 calls per 60000 ms.
# MCP_RATE_LIMIT_CONFIG={"windowMs":60000,"max":60}

########
# Auth #
########

; Auth0 tenant that issues the access tokens Claude sends, and the audience they must carry. Local
; development uses the production tenant and audience (docs/local-development.md). Required.
AUTH0_ISSUER_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.accounter.com
; JWKS endpoint for verifying token signatures (default: <AUTH0_ISSUER_URL>/.well-known/jwks.json).
# AUTH0_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json

############
# Upstream #
############

; Accounter GraphQL server the tools call, with the caller's token forwarded. Required.
GRAPHQL_UPSTREAM_URL=http://localhost:4000/graphql
; Budget for an ordinary upstream call, in ms (default: 10000, max 120000).
# GRAPHQL_UPSTREAM_TIMEOUT_MS=10000
; Budget for slow-by-nature calls (document ingestion, VAT report), in ms. Never lower than
; GRAPHQL_UPSTREAM_TIMEOUT_MS (default: 300000, max 900000).
# GRAPHQL_UPSTREAM_LONG_TIMEOUT_MS=300000

#################
# Observability #
#################

; OpenTelemetry tracing, same conventions as the main server. Optional; off unless OTEL_ENABLED=1.
# OTEL_ENABLED=0
; Required when OTEL_ENABLED=1. The full OTLP/HTTP traces URL, used as-is.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
; Extra exporter headers as key1=value1,key2=value2. [secret] when it carries an auth token.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
# OTEL_SERVICE_NAME=accounter-mcp-server
# OTEL_SERVICE_NAMESPACE=accounter
; Defaults to NODE_ENV, or `development` when NODE_ENV is unset.
# OTEL_DEPLOYMENT_ENV=development
; always_on | always_off | traceidratio | parentbased_traceidratio | parentbased_always_on |
; parentbased_always_off (default: always_on).
# OTEL_TRACES_SAMPLER=always_on
; Sampling ratio between 0 and 1. Required when the sampler is traceidratio or
; parentbased_traceidratio, ignored otherwise.
# OTEL_TRACES_SAMPLER_ARG=0.5
; `true` aborts startup when tracing cannot start; otherwise the server runs without it
; (default: false).
# OTEL_STARTUP_STRICT=false

#####################
# Runtime and tests #
#####################

; Standard Node environment name. Defaults OTEL_DEPLOYMENT_ENV; libraries may read it directly.
; Not validated at startup.
# NODE_ENV=development

; Loads this file instead of `packages/mcp-server/.env`. Read before any .env file is loaded, so it
; only works from the shell or a test harness, never from a .env file.
# TEST_ENV_FILE=.env.test
