{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "postUpdateOptions": ["yarnDedupeFewer"],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "github-actions": {
    "fileMatch": [
      "(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$",
      "(^|/)action\\.ya?ml$",
      "(^|/)setup/action\\.ya?ml",
      "(^|/)website-cf/action\\.ya?ml"
    ]
  },
  "recreateWhen": "auto",
  "prConcurrentLimit": 25,
  "labels": ["dependencies"],
  "rebaseWhen": "conflicted",
  "ignorePaths": ["**/__tests__/**", "**/test/**", "**/tests/**", "**/__fixtures__/**"],
  "dependencyDashboardTitle": "Dependencies Dashboard",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "matchPackageNames": ["!/@changesets/*/", "!/typescript/", "!/^@theguild//"]
    },
    {
      "groupName": "Yoga/Envelop",
      "matchPackageNames": ["@envelop{/,}**", "graphql-yoga{/,}**", "@graphql-yoga{/,}**"]
    },
    {
      "groupName": "urql",
      "recreateWhen": "auto",
      "matchPackageNames": ["@urql{/,}**", "urql{/,}**"]
    },
    {
      "matchDepTypes": ["devDependencies"]
    },
    {
      "groupName": "@theguild/components + nextra",
      "matchPackageNames": [
        "@theguild/components",
        "@theguild/tailwind-config",
        "nextra",
        "nextra-theme-docs",
        "nextra-theme-blog"
      ]
    },
    {
      "groupName": "prettier",
      "matchPackageNames": ["prettier", "@theguild/prettier-config"]
    },
    {
      "description": "TypeScript 7 is the Go rewrite. It ships no programmatic compiler API until 7.1, so typescript-eslint refuses to load (typescript-eslint#10940), which fails `yarn lint` and, through the seven packages whose build is `yarn lint && bob build`, `yarn build` too. It also ships no `lib/tsserver.js`, which breaks the `js/ts.tsdk.path` pin in .vscode/settings.json. Remove this cap once typescript-eslint supports TS7, and re-point the tsdk path in the same change.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Frozen/retired packages - no dependency upgrades. Keep last: rules are applied in order and this must win over the broad rules above.",
      "matchFileNames": [
        "packages/gmail-listener/package.json",
        "packages/gmail-listener/DockerFile",
        "packages/old-accounter/package.json",
        "packages/scraper-local-app/package.json"
      ],
      "enabled": false
    }
  ],
  "dockerfile": {
    "enabled": true,
    "fileMatch": [".*?\\.[dD]ockerfile", "(^|/)[Dd]ocker[Ff]ile$"]
  }
}
